# =============================================================================
# Banco de dados = sua planilha do Google (via Apps Script)
# Passo a passo em DEPLOY.md. Sem isso, rodando local, o app usa data/forms_db.json.
# =============================================================================
SHEETS_WEBAPP_URL="https://script.google.com/macros/s/SEU_ID/exec"
SHEETS_SECRET="a-mesma-senha-que-esta-no-Code.gs"

# Gemini (gerador de formulários por IA). Gere no AI Studio num projeto SEM cobrança.
GEMINI_API_KEY=""

# Opcional: contexto fixo para a IA (substitui o texto de server/aiContext.ts)
AI_FORM_CONTEXT=""

# Quem recebe a cópia de cada resposta e o nome que aparece no e-mail
ADMIN_EMAIL="hugoviajante@gmail.com"
SENDER_NAME="Hugo Gomes Pinheiro"

# =============================================================================
# Configurações de Envio de E-mail (Opcional - Disparo em Produção)
# Se não configurado, o sistema opera em modo de despacho interno seguro com histórico e visualização completa.
# =============================================================================

# Opção 1: Gmail via Nodemailer (Recomendado para contas pessoais/corporativas Google)
# Para gerar a senha de app: https://myaccount.google.com/apppasswords
GMAIL_USER="hugoviajante@gmail.com"
GMAIL_APP_PASSWORD=""

# Opção 2: Resend API
RESEND_API_KEY=""
RESEND_FROM="Formulários <onboarding@resend.dev>"

# Opção 3: Brevo API (Sendinblue)
BREVO_API_KEY=""
BREVO_SENDER="hugoviajante@gmail.com"

# Opção 4: Servidor SMTP Padrão via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@seuservidor.com"

# Opção 5: Webhook Externo (Zapier, Make, n8n)
EMAIL_WEBHOOK_URL=""

