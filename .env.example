# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# Configurações de Envio de E-mail (Opcional - Disparo em Produção)
# Se não configurado, o sistema opera em modo de despacho interno seguro com histórico e visualização completa.
# =============================================================================

# Opção 1: Gmail via Nodemailer (Recomendado para contas pessoais/corporativas Google)
# Para gerar a senha de app: https://myaccount.google.com/apppasswords
GMAIL_USER="hugoviajante@gmail.com"
GMAIL_APP_PASSWORD=""

# Opção 2: Resend API
RESEND_API_KEY=""
RESEND_FROM="Formulários <onboarding@resend.dev>"

# Opção 3: Brevo API (Sendinblue)
BREVO_API_KEY=""
BREVO_SENDER="hugoviajante@gmail.com"

# Opção 4: Servidor SMTP Padrão via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@seuservidor.com"

# Opção 5: Webhook Externo (Zapier, Make, n8n)
EMAIL_WEBHOOK_URL=""

